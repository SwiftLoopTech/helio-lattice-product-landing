      {% for item in homeFaq %}
      <details>
        <summary>{{ item.q }}</summary>
        <div class="faq__a">{{ item.a }}</div>
      </details>
      {% endfor %}
    </div>
  </div>
</section>

<section class="cta">
  <div class="container">
    <h2>Bring a few of your real open jobs. We will walk through them on the screens.</h2>
    <p>A short demo covers enquiry, survey, quotation, delivery checklist, stock and pending payment on the kind of work your team does. We confirm your yearly plan and implementation fee in writing afterwards.</p>
    <div class="cta__actions">
      <a class="btn btn--primary btn--lg" href="/demo/">Book a demo</a>
