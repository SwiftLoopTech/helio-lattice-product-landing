        <div class="ledger__row"><span><b>Needs correction</b><small>Phone number missing or invalid</small></span><span class="pill pill--idle">Fix</span></div>
      </div>
      <p class="mock__caption">Example preview with illustrative rows.</p>
    </div>
  </div>
</section>

